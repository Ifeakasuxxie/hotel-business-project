# The Kings Hotel — environment variable reference
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Prisma / PostgreSQL) ---
# Neon: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/the_kings_hotel?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/the_kings_hotel?schema=public"

# --- Authentication (NextAuth v5) ---
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Database seed (prisma/seed.ts) ---
# SEED_ADMIN_EMAIL="admin@thekingshotel.com"
# SEED_ADMIN_PASSWORD="change-me"

# --- Email (future: Resend) ---
RESEND_API_KEY=""

# --- Image storage (future: Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Payments (future: Stripe / Paystack) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
